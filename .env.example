APP_ENV=development
POSTGRES_DB=meguyomi
POSTGRES_USER=meguyomi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://meguyomi:change-me@postgres:5432/meguyomi
REDIS_URL=redis://redis:6379/0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_ROOT=/storage
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=100
PREVIEW_RENDER_SCALE=2.0
LOCAL_AI_URL=http://local-ai:8001
LOCAL_AI_TIMEOUT_SECONDS=600
LOCAL_AI_MAX_IMAGE_BYTES=16777216
LOCAL_AI_MAX_TILE_ASPECT_RATIO=2.0
LOCAL_AI_TILE_OVERLAP_RATIO=0.2
PREPARATION_TIMEOUT_SECONDS=600
TRANSLATION_HEARTBEAT_TIMEOUT_SECONDS=300
TRANSLATION_QUEUE_RECOVERY_DELAY_SECONDS=60
TRANSLATION_CHECKPOINT_RETENTION_DAYS=7
TRANSLATION_QUALITY_RESCAN_ATTEMPTS=1
API_URL=http://api:8000
