APP_ENV=development
POSTGRES_DB=meguyomi
POSTGRES_USER=meguyomi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://meguyomi:change-me@postgres:5432/meguyomi
REDIS_URL=redis://redis:6379/0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_ROOT=/storage
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=100
PREVIEW_RENDER_SCALE=2.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_IMAGE_BYTES=13631488
GEMINI_MAX_RESPONSE_BYTES=2097152
GEMINI_MAX_OUTPUT_TOKENS=8192
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
