APP_ENV=development
POSTGRES_DB=meguyomi
POSTGRES_USER=meguyomi
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://meguyomi:change-me@postgres:5432/meguyomi
REDIS_URL=redis://redis:6379/0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_ROOT=/storage
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=100
PREVIEW_RENDER_SCALE=2.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_IMAGE_BYTES=13631488
GEMINI_MAX_RESPONSE_BYTES=2097152
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_TILE_ASPECT_RATIO=2.0
GEMINI_TILE_OVERLAP_RATIO=0.12
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=15
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_DELAY_SECONDS=5
GEMINI_RETRY_MAX_DELAY_SECONDS=60
GEMINI_INLINE_RETRY_MAX_DELAY_SECONDS=15
GEMINI_SERVICE_RETRY_DELAYS_SECONDS=[60,300,900]
GEMINI_RATE_LIMIT_RETRY_DELAYS_SECONDS=[60,900,3600]
GEMINI_RETRY_HINT_MAX_SECONDS=86400
GEMINI_DEFERRED_RETRY_JITTER_RATIO=0.25
GEMINI_DEFERRED_RETRY_JITTER_MAX_SECONDS=60
PREPARATION_TIMEOUT_SECONDS=600
TRANSLATION_HEARTBEAT_TIMEOUT_SECONDS=300
TRANSLATION_QUEUE_RECOVERY_DELAY_SECONDS=60
TRANSLATION_CHECKPOINT_RETENTION_DAYS=7
API_URL=http://api:8000
